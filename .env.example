# Salin ke .env. Pisahkan beberapa password dengan koma; jangan gunakan koma dalam password.
NUXT_ADMIN_PASSWORDS=
# Variabel tunggal ini tetap didukung untuk kompatibilitas deployment lama.
NUXT_ADMIN_PASSWORD=
NUXT_SESSION_SECRET=
# Opsional: URL layanan Gotenberg privat (bukan URL aplikasi Vercel).
NUXT_GOTENBERG_URL=
NUXT_GOTENBERG_USERNAME=
NUXT_GOTENBERG_PASSWORD=
